# syntax=docker/dockerfile:1.7
#
# Studio: the operator UI, served as static files.
#
# NOTE: `apps/studio` does not exist in the repository yet. This image is
# written against the shape the compose stack expects — a Vite-style build that
# emits `dist/` — and the `build` stage will fail loudly if the app is absent
# rather than silently producing an empty site. That is deliberate: an empty
# nginx answering 200 on / would look exactly like a working deployment.
#
# Studio talks to the BFF and to nothing else (M7): it holds no database
# credentials, so this image ships no secrets and needs none.

ARG NODE_IMAGE=node:24-bookworm-slim
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine

FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true
RUN corepack enable
WORKDIR /app

# `tsconfig.base.json` travels with the manifests, not with the sources.
# Every package's tsconfig `extends` it, and a missing extends target does not
# error — TypeScript falls back to its own defaults, so `resolveJsonModule` and
# `module: ESNext` silently vanish and the build fails inside `@maestro/config`
# on an import that is correct. The error names the wrong file, which is what
# makes this worth a comment rather than a one-word fix.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    test -d apps/studio || { \
      echo "apps/studio is not in this repository — build it before building this image"; \
      exit 1; \
    } \
 && pnpm install --frozen-lockfile --ignore-scripts \
 && pnpm --filter @maestro/studio build

# ── serve ────────────────────────────────────────────────────────────────────
# nginx-unprivileged rather than the stock nginx image: the stock one starts as
# root to bind port 80 and only then drops to `nginx` for its workers. This one
# never runs as root at all and listens on 8080, which is why the compose file
# maps 7000 to 8080 instead of to 80.
FROM ${NGINX_IMAGE} AS runner
COPY deploy/docker/studio-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/studio/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
