# =============================================================================
# Maestro — registry kurulumu (.env)      BUNDLE_VERSION: 2026-08-27
#   cp .env.example .env && chmod 600 .env → DEGISTIR yazan 4 alanı doldur
#   → docker compose pull → ./install.sh
# =============================================================================
# Jira jetonu, GitHub jetonu ve model anahtarı BU DOSYADA DURMAZ. Kurulumdan
# sonra panelden girilir, veritabanına şifreli yazılır ve koşular oradan okur.
# Burada yalnızca panelin kendisini ayağa kaldıran şeyler kalır.
#
# ⚠ Bu dosyayı YEDEKLEYİN: CONNECTOR_MASTER_KEY kaybolursa panele girilmiş
#   bütün bağlantı jetonları BİR DAHA ÇÖZÜLEMEZ.
# =============================================================================


# ── BUNDLE SÜRÜMÜ — dokunmayın ──────────────────────────────────────────────
# install.sh `^BUNDLE_VERSION=` atamasını okuyup paketin kendi sürümüyle
# karşılaştırır. Atama yorumda değil BURADA durmalı: yalnız yorumda kaldığı
# bir dönem kontrol hiç ateşlenmedi ve bayat .env sahada fark edilmedi.
BUNDLE_VERSION="2026-08-27"


# ── DOLDURULACAK (4) ─────────────────────────────────────────────────────────
# Panele taşınamayan tek küme bunlar: süreç, veritabanına nasıl bağlanacağını
# öğrenmek için veritabanını okuyamaz.
POSTGRES_PASSWORD="DEGISTIR"           # openssl rand -hex 24
REDIS_PASSWORD="DEGISTIR"              # openssl rand -hex 16

# Panelden girilen jetonları AES-256-GCM ile şifreler. Anahtar burada durur,
# veritabanında DURMAZ — koruduğu deponun içinde saklanan bir anahtar koruma
# sağlamaz. Tam 32 bayt olmalı; install.sh base64 çözüp doğrular.
CONNECTOR_MASTER_KEY="DEGISTIR"        # openssl rand -base64 32

# ── BU NEDEN PANELE TAŞINMADI, diğer jetonlar taşındığı hâlde ───────────────
# Bu sır, DIŞARIDAN gelen ve HENÜZ DOĞRULANMAMIŞ bir isteği doğrular:
# `POST /webhooks/jira` gövdeyi ayrıştırmadan ÖNCE imzayı kontrol eder.
# Veritabanından okusaydık, imza kontrolünün ÖNÜNE bir veritabanı sorgusu
# koymuş olurduk — adresi bilen herkesin sahte istekle sorgu yaptırabildiği,
# hız sınırı olmayan bir uç nokta. Diğer jetonlar sistemin KENDİ başlattığı
# çağrılarda okunur; bu ise yabancının başlattığı bir istekte.
#
# ⚠ Ad referanstan TÜRETİLİR (kv/jira#webhook → '#' ÇİFT alt çizgi olur).
#   Bir alt çizgi eksikse sürücü "secret not found" der, siz .env'de değeri
#   dolu görürsünüz ve aradaki farkı anlamanın yolu olmaz.
MAESTRO_SECRET_KV_JIRA__WEBHOOK="DEGISTIR"   # openssl rand -hex 32


# ── JIRA ADRESİ — İKİ SATIRDAN YALNIZCA BİRİNİ DOLDURUN ─────────────────────
# Sürücüyü SEÇEN ayrı bir değişken YOKTUR (apps/deploy/src/profile.ts,
# `workDriverFor`): hangi adresi doldurduysanız o sürücü çalışır.
#   JIRA_CLOUD_BASE_URL → Cloud sürücüsü  (`Basic <e-posta>:<jeton>`)
#   JIRA_BASE_URL       → Data Center      (`Bearer <PAT>`)
# İkisi de dolu → açılış adıyla reddedilir; hangisinin kazandığı tahmin
# edilmez ve yanlış tahmin, ticket'ları yanlış Jira'ya yazmak demektir.
# İkisi de boş → yığın yine açılır, panel çalışır, Jira'ya erişimde adıyla
# "henüz tanımlanmadı" der. ⚠ JETON BURAYA YAZILMAZ, yalnızca ADRES.
# JIRA_CLOUD_BASE_URL="https://kurum.atlassian.net"   # sonunda / OLMADAN
# JIRA_BASE_URL="https://jira.kurum.local"

# Cloud'da Basic kimlik doğrulamanın kullanıcı adı. Data Center'da gereksiz.
MAESTRO_BOT_EMAIL="maestro-bot@kurum.local"


# ── YAPAY ZEKÂ UÇ NOKTASI ───────────────────────────────────────────────────
# MODEL ARTIK BURADAN DEĞİL, PANELDEN TANIMLANIR.
#
# Kurulum bittikten sonra Studio'da "Ayarlar & bağlantılar" ekranını açın,
# "Kurum içi model sunucusu (OpenAI uyumlu)" türünde bir bağlantı ekleyin ve
# şunları TEK YERDE girin: adres, model adı, (gerekiyorsa) API anahtarı,
# "bu sunucu kurum içinde çalışıyor" işareti ve "varsayılan model olsun".
# "Test et" düğmesi sunucuya bağlanır, /v1/models listesini okur ve yazdığınız
# modeli GERÇEKTEN sunuyor mu diye bakar — sunmuyorsa yeşil YANMAZ.
# Kaydettiğiniz anda çalışan servisler onu kullanır; yeniden başlatma gerekmez.
#
# Aşağıdaki üç satır bu yüzden BOŞ BIRAKILABİLİR ve varsayılan olarak boştur.
# Hiç model tanımlanmamış bir kurulum yine de AÇILIR; ilk model çağrısında
# "henüz bir model tanımlanmadı" diyerek adıyla reddeder. Zaten panelin
# açılabilmesi için servislerin ayakta olması gerekir.
#
# Doldurursanız: panelde model satırı YOKSA bu değerler kullanılır. Hâlihazırda
# çalışan bir kurulum bu sürüme geçtiğinde böylece hiçbir şey değişmez.
# ⚠ Doldururken sonuna `/v1` YAZMAYIN — sürücü kendisi ekler, yoksa her çağrı
#   404 döner. (Panele yazarken bu tuzak kendiliğinden temizlenir.)
LLM_BASE_URL=""
LLM_MODEL=""
# Yalnız yukarıdaki .env değerleriyle çalışan kurulumlar için geçerlidir.
# Panelde tanımlı bir model varsa OKUNMAZ — oradaki "kurum içinde çalışıyor"
# işareti geçerlidir. `false` ise `gizli` sınıflı işler ON-PREM MODEL YOK
# sayılır ve analiz "elle tamamlayın" diye biter — hata değil, EKSİK ÇIKTI.
LLM_ON_PREM="true"


# ── İMAJLAR ─────────────────────────────────────────────────────────────────
# Aşağıdakiler Docker Hub'dan doğrudan çalışır. Kurum registry'sine (Nexus,
# Harbor) mirror'ladıysanız satırın TAMAMINI kendi adresinizle değiştirin.
# ⚠ Etiket sabit — `latest` kullanmayın; geri alma imkânsızlaşır.
MAESTRO_NODE_IMAGE="docker.io/uguryldz/maestro-node:1.0.8"
MAESTRO_STUDIO_IMAGE="docker.io/uguryldz/maestro-studio:1.0.8"
POSTGRES_IMAGE="docker.io/uguryldz/maestro-postgres:17-alpine"
REDIS_IMAGE="docker.io/uguryldz/maestro-redis:7-alpine"
TEMPORAL_IMAGE="docker.io/uguryldz/maestro-temporal:1.25.2"


# ── TEMEL AYARLAR — varsayılanları doğrudur ─────────────────────────────────
NODE_ENV="development"                 # sırlar .env'de, belgeler Postgres'te
POSTGRES_USER="maestro"
POSTGRES_DB="maestro"
STUDIO_PORT="7000"                     # panelin dışarı açıldığı TEK port
# Ters vekil arkasındaysanız: STUDIO_PORT="127.0.0.1:7000"


# =============================================================================
# OPSİYONEL — çoğu kurulumda GEREKMEZ, olduğu gibi bırakın
# =============================================================================
# ⚠ BOŞ BIRAKMAK İLE SİLMEK AYNI ŞEYDİR: compose bu değişkenleri `${AD:-}`
#   biçiminde iletir, yani yazmadığınız değişken konteynere boş dize olarak
#   girer ve uygulama boş dizeyi "ayarlanmamış" okur. Kullanacaksanız `#`
#   işaretini kaldırıp değeri yazın; kullanmıyorsanız hiç dokunmayın.
#
# Aşağıda YAZILI OLMAYAN her ayarın (sır POINTER'ları — JIRA_TOKEN_REF,
# LLM_API_KEY_REF, GITHUB_TOKEN_REF, ADO_*_REF, LDAP_BIND_PASSWORD_REF —
# ayrıca ADO_*, LDAP_*, IDENTITY_DRIVER, STORAGE_*, VAULT_MOUNTS) varsayılanı
# kodun varsayılanıyla birebir aynıdır ve compose onu kendisi yazar. Bir
# saha gerçekten ihtiyaç duyarsa README §7'ye bakın.

# Aynı sunucuda İKİNCİ bir kurulum (kabul/test) yapacaksanız ŞART: aynı adla
# kurulan ikinci yığın compose için yeni kurulum değil, MEVCUDUN
# GÜNCELLENMESİDİR — çalışan üretimin volume'üne bağlanır. STUDIO_PORT'u da
# değiştirin.
# COMPOSE_PROJECT_NAME="maestro-kabul"

# Kurumsal TLS: Jira DC / TFS ya da kurum içi model sunucunuzun (OpenShift
# route'u, vLLM) sertifikası kurumun kendi kök CA'sıyla imzalıysa ŞART, yoksa
# her çağrı sertifika hatasıyla düşer — panelin bağlantı testi bunu
# "TLS sertifikası doğrulanamadı (SELF_SIGNED_CERT_IN_CHAIN)" gibi koduyla
# söyler. CA dosyasını certs/ klasörüne koyup satırı açın — install.sh
# dosyayı diskte ARAR, bulamazsa kurulumu durdurur.
CA_BUNDLE_DIR="./certs"
# NODE_EXTRA_CA_CERTS="/etc/maestro/kurumsal-kok-ca.pem"

# Yalnızca GitHub Enterprise Server için, İKİSİ BİRLİKTE. Boşsa github.com.
# GITHUB_API_BASE_URL="https://github.kurum.local/api/v3"
# GITHUB_GRAPHQL_URL="https://github.kurum.local/api/graphql"

# LDAP/AD ile giriş: IDENTITY_DRIVER="ldaps-bind" yazarsanız LDAP_URL,
# LDAP_USER_BASE_DN ve LDAP_BIND_DN ZORUNLU olur. Varsayılan `local`
# hesaptır ve önerilen de budur — LDAP'ı sistem çalıştıktan sonra açın.
# ⚠ Değişkenin adı LDAP_USER_BASE_DN'dir; `LDAP_BASE_DN` hiçbir şema
#   tarafından OKUNMAZ — LDAP dolu görünür, hiç çalışmaz.
# IDENTITY_DRIVER="ldaps-bind"
# LDAP_URL="ldaps://dc.kurum.local:636"          # düz ldap:// üretimde reddedilir
# LDAP_USER_BASE_DN="OU=Users,DC=kurum,DC=local"
# LDAP_BIND_DN="CN=maestro-svc,OU=ServiceAccounts,DC=kurum,DC=local"
# LDAP_ROLE_MAPPINGS="maestro-admins:admin,maestro-qa:qa"
# MAESTRO_SECRET_KV_LDAP__SERVICE__2D_PASSWORD=""

# Azure DevOps kullanan bir saha için. ADO_PR_VALIDATION_BUILDS boş
# bırakılamaz — boş liste "hepsine izin ver" diye değil, HATA okunur (M12).
# ADO_BASE_URL="https://tfs.kurum.local/tfs/DefaultCollection"
# ADO_ORG="DefaultCollection"
# ADO_PROJECT="CoreBanking"
# ADO_PR_VALIDATION_BUILDS="core-api:42,core-web:43"
# MAESTRO_SECRET_KV_ADO__TOKEN=""
# MAESTRO_SECRET_KV_ADO__WEBHOOK=""

# Panelde bağlantı tanımlamadan denemek isteyen kurulum için YEDEK yol.
# Panelde bağlantı varsa O kazanır ve bu değerler yok sayılır (log'a düşer).
# MAESTRO_SECRET_KV_JIRA__TOKEN=""
# MAESTRO_SECRET_KV_GITHUB__TOKEN=""
# MAESTRO_SECRET_KV_LLM__API__2D_KEY=""
# MAESTRO_BOT_ACCOUNT_ID=""            # boş bırakın: panel testi /myself ile kendisi bulur
# JIRA_CLOUD_EMAIL=""                  # MAESTRO_BOT_EMAIL boşsa buna düşülür

# ── Onay kapıları → Jira grupları (README §4.7) ─────────────────────────────
# /approve, karar verenin JİRA GRUBU üyeliğiyle doğrulanır. Boşken rol adının
# KENDİSİ grup adı sayılır: Jira'nızda product-owners / tech-leads / qa adında
# gruplar varsa hiçbir şey yapmanız gerekmez. YOKSA her onay "üye değil" diye
# reddedilir — kapı fail-closed'dır. Rolleri kendi grup adlarınıza eşleyin
# (biçim rol=grup, virgülle; roller: product-owners, tech-leads, qa):
# GATE_GROUPS="product-owners=jira-po-grubu,tech-leads=jira-lider-grubu,qa=jira-test-grubu"
# Tek onaycı grubu olan saha için: eşlemede adı geçmeyen her rol buna düşer.
# GATE_GROUP_DEFAULT="maestro-onay"

# Jira yorumlarındaki komutları (/approve) YOKLAMAYLA okuma aralığı (ms).
# Boş/0 = kapalı. Webhook'u çalışan kurulum AÇMASIN — aynı yorum iki kez
# işlenir. Jira Cloud'da webhook imzası doğrulanamadığından /approve'un
# ticket'tan işlenebilmesinin TEK yolu budur.
# JIRA_POLL_MS="60000"

# Hiçbir dinleme kuralı eşleşmeyen ticket'ın akışı. Boşken TAM boru hattı
# (analiz + kod + PR) varsayılır. Yalnız analiz için kurulan sahada "analiz"
# önerilir — kural dışı kalan bir ticket kod yazan akışa düşmesin. Zorunlu
# değildir. Değerler: analiz | duzeltme | gelistirme.
# MAESTRO_FLOW="analiz"

# ── Depo keşfi: analiz, ticket'ın deposunu OKUYARAK yapılsın ────────────────
# Boşken bugünkü davranış aynen sürer: analiz depoyu görmeden yapılır. Açmak
# için WORKSPACE_ROOT'u compose'un bff ve worker'a birlikte bağladığı ortak
# alana ("/workspace") yazın — bff koşu başında depoyu oraya klonlar, worker
# analizde oradan okur. Klon en-iyi-çabadır: erişilemeyen depo analizi
# düşürmez, "depo çekilemedi" uyarısıyla depsuz sürer. Alan tmpfs'tir (1g),
# yeniden başlatmada temizlenir.
# WORKSPACE_ROOT="/workspace"
# Özel depo için jetonun sır ADRESİ; değer yukarıdaki YEDEK yol bloğundaki
# MAESTRO_SECRET_KV_GITHUB__TOKEN satırından okunur. Kurum içi SCM için SCM_HOST.
# SCM_TOKEN_REF="kv/github#token"
# SCM_HOST="github.kurum.local"

# İlk 'admin' parolasını runbook'la sabitlemek isteyen saha için (README §8).
# BOŞ BIRAKIN: boşken parola rastgele üretilir ve migrate çıktısına BİR KEZ
# basılır. Dolu verilirse hiç basılmaz; ilk girişte değişim yine zorunludur.
# MAESTRO_BOOTSTRAP_PASSWORD=""

# Yalnızca NODE_ENV="production" ile: sırlar Vault'ta, belgeler S3'te.
# Vault kurulmadan production YAZMAYIN — süreç açılışta ölür.
# VAULT_ADDR="https://vault.kurum.local"
# VAULT_ROLE_ID=""
# VAULT_SECRET_ID=""
# STORAGE_ENDPOINT="https://s3.kurum.local"

# ⚠ BFF_PORT BURADA YOKTUR ve bu bir eksiklik değil, düzeltmedir. BFF'in
#   konteyner içindeki portu 7001'de SABİTTİR (compose, healthcheck ve
#   studio-nginx.conf'ta aynı sayı). .env'e BFF_PORT yazan bir kurulum şunu
#   yaşadı: süreç başka portu dinledi, healthcheck 7001'i yokladı, bff hiç
#   'healthy' olmadı, studio hiç başlamadı. Dışarı açılan port STUDIO_PORT'tur.
BFF_HOST="0.0.0.0"                     # konteyner içi; loopback'i nginx göremez
TEMPORAL_NAMESPACE="default"

# Docker daemon soketi. 'autoheal' servisi bunu SALT-OKUNUR bağlar: Docker'ın
# olay akışını dinler ve YALNIZ bu yığının sağlıksız işaretlenen konteynerini
# yeniden başlatır (yaratmaz, silmez, yapılandırma değiştirmez).
#
# Neden gerekli: compose sağlık durumuna göre restart ETMEZ — `restart:
# unless-stopped` yalnız süreç ölünce devreye girer. Analiz kurulumunu asıl
# kilitleyen arıza ise bunun tersidir: worker ayakta ama artık iş alamıyor.
# Soketin standart dışı bir yolda olduğu kurulumlarda (rootless Docker,
# Podman) burayı değiştirin.
DOCKER_SOCKET_PATH="/var/run/docker.sock"

# Docker soketinin GRUP kimliği (gid). autoheal konteyneri uid 10001 ile
# koşar; soket root:docker sahiplidir, dolayısıyla bu gruba ek üyelik almadan
# her çağrısı EACCES alır ve hiçbir şeyi kurtaramaz.
#
# Sunucunuzunkini bulun:   stat -c '%g' /var/run/docker.sock
# install.sh bunu kendisi bulup yazar; elle kurulumda doldurun.
DOCKER_GID="999"

# Jira'yı TARAYIP yeni ticket bulma aralığı (ms). Boş/0 = kapalı.
#
# JIRA_POLL_MS'ten FARKLI bir iş yapar: o, platformun zaten aldığı ticket'ların
# yorumlarını okur (/approve); bu, ticket'ı ilk kez BULUR. İkisi de kapalıyken
# bir ticket'ın Maestro'ya girmesinin tek yolu Jira webhook'udur — kurulmadıysa
# panel açıktır, bağlantı yeşildir, kurallar doğrudur ve hiç ticket gelmez.
#
# Webhook çalışan bir kurulumda gerek yoktur (anında ve bedava). Webhook
# kuramayan saha için doğru yol budur: dinleme kurallarındaki proje + bot
# ataması JQL'e çevrilir, eşleşen ve daha önce görülmemiş ticket'lar alınır.
# 300000 (5 dk) makul bir başlangıçtır: Jira'yı yormaz, bir ticket'ın
# alınması için en kötü ihtimalle 5 dakika bekletir.
JIRA_DISCOVER_MS="300000"
