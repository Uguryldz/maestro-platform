# Maestro deployment environment.
#
#   cp deploy/.env.example deploy/.env   and fill in the REQUIRED values.
#
# `deploy/.env` is git-ignored (see .gitignore: `.env` / `.env.*`, with
# `.env.example` explicitly re-included). This file must never contain a real
# credential — everything here is either a non-secret setting, a REFERENCE to a
# secret, or a local-only development password.
#
# Two kinds of variable are easy to confuse and matter a great deal:
#
#   *_REF                 a POINTER to a secret ("kv/jira#token"). Safe to
#                         commit, safe to log, safe to put in an image.
#   MAESTRO_SECRET_*      the VALUE behind a pointer, in the dev profile only.
#                         Never commit these. In the prod profile they do not
#                         exist at all — Vault holds the values.
#
# "REQUIRED" below means the process refuses to start without it (M6
# fail-closed). It does not warn and carry on.


# ─────────────────────────────────────────────────────────────────────────────
# Profile
# ─────────────────────────────────────────────────────────────────────────────

# Which drivers get composed. REQUIRED (defaults from NODE_ENV if unset).
#   dev   secrets from MAESTRO_SECRET_* variables, blobs in Postgres,
#         notifications posted to the Jira ticket
#   prod  secrets from Vault, blobs in S3-compatible storage, Teams+SMTP
# The dev profile REFUSES to run under NODE_ENV=production.
MAESTRO_PROFILE=dev

# development | test | production. REQUIRED in effect: `production` turns on
# every fail-closed check in @maestro/config.
NODE_ENV=development


# ─────────────────────────────────────────────────────────────────────────────
# Datastores  (compose supplies these; set them when running outside compose)
# ─────────────────────────────────────────────────────────────────────────────

# Local Postgres, reachable only inside the compose network. NOT a secret in
# the sense that matters — it guards nothing outside your machine — but do
# change it for anything shared.
POSTGRES_USER=maestro
POSTGRES_PASSWORD=DEGISTIR-parola-uret-openssl-rand-hex-24
POSTGRES_DB=maestro
POSTGRES_PORT=5432

# REQUIRED in production. Compose builds this from the three values above, so
# leave it unset there; set it when running a service outside compose.
# DATABASE_URL=postgresql://maestro:DEGISTIR-parola-uret-openssl-rand-hex-24@localhost:5432/maestro

# REQUIRED in production. Compose points this at the `temporal` service.
# TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Task queue the worker polls. Optional; defaults to `maestro-delivery`.
# TEMPORAL_TASK_QUEUE=maestro-delivery


# ─────────────────────────────────────────────────────────────────────────────
# Ports published on the host
# ─────────────────────────────────────────────────────────────────────────────

BFF_PORT=7001
STUDIO_PORT=7000
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233


# ─────────────────────────────────────────────────────────────────────────────
# Jira  (the WorkPort)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Base URL of the Jira Data Center instance.
JIRA_BASE_URL=https://jira.example.local

# Secret REFERENCES — pointers, not values. Safe to commit.
JIRA_TOKEN_REF=kv/jira#token
JIRA_WEBHOOK_SECRET_REF=kv/jira#webhook


# ─────────────────────────────────────────────────────────────────────────────
# Azure DevOps  (the ScmPort and the CiPort)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED.
ADO_BASE_URL=https://dev.azure.com
ADO_ORG=your-organisation
ADO_PROJECT=YourProject

# REQUIRED, and there is deliberately no default.
#
# The allow-list of PR-validation build definitions whose results may close the
# CI gate, as `repo:definitionId` pairs, comma separated. An empty list is
# REFUSED rather than read as "allow all": without it, any pipeline in the
# organisation could answer for this repository's validation gate (M12).
ADO_PR_VALIDATION_BUILDS=your-repo:42

ADO_TOKEN_REF=kv/ado#token
ADO_WEBHOOK_SECRET_REF=kv/ado#webhook
# Username half of the Service Hook basic-auth credential. Optional.
ADO_WEBHOOK_USERNAME=maestro-ci


# ─────────────────────────────────────────────────────────────────────────────
# LLM gateway
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. OpenAI-compatible endpoint — WITHOUT the `/v1` suffix.
#
# The driver appends `/v1/chat/completions` itself
# (packages/llm-gateway/src/driver-openai.ts). Writing the suffix here produces
# `/v1/v1/chat/completions`, which every OpenAI-compatible server answers with
# 404 — and the failure surfaces as "model call failed", not as a bad URL.
LLM_BASE_URL=https://llm.example.local
LLM_MODEL=gpt-4o-mini
# The key is sent as a Bearer header unconditionally, so a local endpoint that
# needs no auth still requires a non-empty value here: an empty secret reads as
# "not configured" and raises SecretNotFoundError before the first call.
LLM_API_KEY_REF=kv/llm#api-key

# `true` when the endpoint is genuinely on premises. This is not cosmetic: with
# `false`, a `gizli` payload is either masked or refused according to the
# gateway's onPremMissing policy. Claiming on-prem for a cloud endpoint would
# route confidential data outward with no mask (M18/M20).
LLM_ON_PREM=false


# ─────────────────────────────────────────────────────────────────────────────
# Object storage  (prod profile only — the dev profile stores blobs in Postgres)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED in production.
STORAGE_ENDPOINT=https://s3.example.local
STORAGE_BUCKET=maestro-evidence
STORAGE_REGION=us-east-1


# ─────────────────────────────────────────────────────────────────────────────
# Vault  (prod profile only)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED in production. Must be https outside development.
VAULT_ADDR=https://vault.example.local

# KV mounts this deployment may read (least privilege, M6).
# `git` must stay in the list: the short-lived repository push credential is
# issued from it (M31), and a list without it composes fine and then denies
# every push at the first engineering turn.
VAULT_MOUNTS=kv,git

# REQUIRED by the prod profile. The AppRole is the one credential that cannot
# itself come from Vault.
#
# VAULT_SECRET_ID IS A SECRET. Do not commit it, do not paste it into a ticket,
# and prefer injecting it from your orchestrator's secret store rather than
# from a file on disk.
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=


# ─────────────────────────────────────────────────────────────────────────────
# Scanners  (M27)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED, and DIGEST-PINNED — a tag is refused.
#
# A tag is a moving target: the same `trivy:latest` that passed a gate on
# Monday can be a different binary on Tuesday, and a scan gate whose scanner
# can change without a deployment is not evidence of anything. Resolve a digest
# with `docker buildx imagetools inspect <image>:<tag>`.
SCAN_IMAGE_TRIVY=aquasec/trivy@sha256:REPLACE_WITH_A_REAL_DIGEST
SCAN_IMAGE_SEMGREP=semgrep/semgrep@sha256:REPLACE_WITH_A_REAL_DIGEST
SCAN_IMAGE_GITLEAKS=zricethezav/gitleaks@sha256:REPLACE_WITH_A_REAL_DIGEST

# Docker socket the container runner uses. Optional.
DOCKER_SOCKET_PATH=/var/run/docker.sock


# ─────────────────────────────────────────────────────────────────────────────
# Base images
# ─────────────────────────────────────────────────────────────────────────────
#
# Optional. Version-pinned by default; override with a DIGEST to pin exactly.
#
# The scanner images above are digest-ONLY and a tag is refused, because their
# output closes a security gate and evidence produced by a binary that can
# change without a deployment is not evidence. These four are a database, a
# workflow engine, a read-only UI and a coordination store: the same argument
# applies with less force, so they are version-pinned here and digest-pinnable
# by you.
#
# For a bank deployment, resolve and set all four:
#   docker buildx imagetools inspect postgres:17-alpine
#
# POSTGRES_IMAGE=postgres@sha256:...
# TEMPORAL_IMAGE=temporalio/auto-setup@sha256:...
# TEMPORAL_UI_IMAGE=temporalio/ui@sha256:...
# REDIS_IMAGE=redis@sha256:...
# NODE_IMAGE=node@sha256:...        (build arg for docker/Dockerfile.node)


# ─────────────────────────────────────────────────────────────────────────────
# Identity — AD/LDAPS  (M8)
# ─────────────────────────────────────────────────────────────────────────────
#
# `local` is the MVP bcrypt account store and stays the default so existing
# dev setups keep working. A bank deployment sets `ldaps-bind`, and from that
# moment the platform NEVER verifies a password itself: it binds to the
# directory as the user. No password hash is ever received, stored or logged.
#
# IDENTITY_DRIVER=ldaps-bind

# The directory. LDAPS is mandatory: plain ldap:// is refused outright under
# NODE_ENV=production, whatever LDAP_ALLOW_INSECURE says, because a bind over
# it puts the user's corporate password on the wire in cleartext. StartTLS is
# deliberately NOT supported — it starts in plaintext and upgrades, which is a
# downgrade window `ldaps://` does not have.
# LDAP_URL=ldaps://ad.bank.local:636

# Where the driver searches. These are facts about YOUR directory and have no
# safe default: a guessed base DN does not error, it silently finds nobody.
# LDAP_USER_BASE_DN=OU=Users,DC=bank,DC=local
# LDAP_GROUP_BASE_DN=OU=Groups,DC=bank,DC=local

# The service account used for the SEARCH bind only — never for a user's bind.
# It needs read access to the user and group subtrees and nothing else.
# LDAP_BIND_DN=CN=svc-maestro,OU=Service,DC=bank,DC=local

# The service-account password lives in Vault. What appears here is only the
# REFERENCE (`mount/path#field`), which is why this line is safe to commit —
# the same rule as every other *_REF above (M80). There is deliberately no
# LDAP_BIND_PASSWORD variable: a password in the environment is a password in
# every `docker inspect` and every crash dump.
# LDAP_BIND_PASSWORD_REF=kv/ldap#service-password

# The bank's own CA, PEM. Corporate directories are rarely signed by a public
# root, and without this the driver correctly refuses to verify the peer.
# Supplying the CA is what makes "never disable verification" a rule you can
# actually keep — note there is NO option in this platform to turn certificate
# checking off, by design.
# LDAP_CA_CERT_PATH=/etc/maestro/ldap-ca.pem

# ─────────────────────────────────────────────────────────────────────────────
# Corporate TLS trust  (HTTP adapters: Jira DC, Azure DevOps Server, GitHub ES)
# ─────────────────────────────────────────────────────────────────────────────
#
# LDAP_CA_CERT_PATH above covers the LDAP client only. The HTTP adapters use the
# platform `fetch`, which trusts Node's built-in CA bundle — an internal Jira DC
# or TFS certificate signed by the bank's own root is NOT in it, so every call
# fails with `unable to verify the first certificate`.
#
# Node honours this variable process-wide; no code change is needed. Mount the
# bank's root CA into the container and point at it. Do NOT disable
# verification instead — that turns a trust problem into an interception risk.
# NODE_EXTRA_CA_CERTS=/etc/maestro/corporate-root-ca.pem

# Search filters. `{{username}}` is substituted with the login name AFTER it is
# escaped (RFC 4515), so an input like `*)(uid=*` is treated as data, not as
# filter syntax. The defaults target Active Directory.
#
# The default user filter also excludes disabled accounts at the directory
# (userAccountControl bit 2). The driver checks that attribute independently as
# well, so editing this filter cannot re-open the "cancelled account kept its
# authority" finding.
# LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={{username}})(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
#
# The default group filter follows NESTED groups (matching rule 1.2.840.113556.1.4.1941):
# someone in `payments-squad`, which is itself inside `maestro-developers`,
# holds the second group in practice.
# LDAP_GROUP_FILTER=(&(objectClass=group)(member:1.2.840.113556.1.4.1941:={{dn}}))

# Group → role mapping. THIS REPLACES THE OLD HARDCODED `maestro-<projectkey>`
# CONVENTION: your AD group names are yours, and the platform must not require
# you to rename them.
#
# Compact form — `group:role1|role2`, entries separated by commas:
# LDAP_ROLE_MAPPINGS=maestro-admins:admin,maestro-qa:qa,maestro-leads:tech-lead|developer
#
# A group DN contains commas, which collide with that separator, so DNs use the
# JSON array form instead (the driver refuses a bare DN in the compact form
# rather than splitting it into keys that would match nothing):
# LDAP_ROLE_MAPPINGS=[{"group":"CN=maestro-admins,OU=Groups,DC=bank,DC=local","roles":["admin"]}]
#
# Roles are a closed set: admin · tech-lead · product-owner · qa · developer ·
# viewer. A typo is rejected at boot rather than silently granting nothing.
# Group names Maestro does not recognise are still carried on the session and
# still audited — they simply grant no authority. They are never dropped: a
# person must not appear to hold less than the directory granted them.
#
# Everyone who authenticates also gets `viewer` as a floor, so an account whose
# mapping fails sees a read-only platform rather than a broken one.

# Local test directories only. Refused under NODE_ENV=production regardless.
# LDAP_ALLOW_INSECURE=false


# ─────────────────────────────────────────────────────────────────────────────
# Sandbox runner  (M21/M27/M30)
# ─────────────────────────────────────────────────────────────────────────────
#
# The image an ENGINEERING TURN runs the agent's verification commands inside.
#
# Leave it unset and the platform still starts, still takes tickets and still
# runs the analysis and the approval gates — but step 6a refuses by name
# ("no sandbox fleet is configured"), and the twelve steps behind it never run.
# That is the deliberate narrow refusal in `buildTurnRunner`; it is not a
# crash, and it is not a silent skip. The pilot's first end-to-end ticket needs
# this set.
#
# DIGEST-PINNED, and the runner's own schema refuses a tag — same rule as the
# scanner images above and the same reason: a build environment that can change
# without a deployment makes every verification result unreproducible.
#
# WHERE TO GET IT: build your bank's own image with the toolchain your repos
# need (Node, JDK, .NET — whatever `.maestro.yaml` calls), push it to the
# internal registry, then resolve the digest:
#   docker buildx imagetools inspect registry.bank.local/maestro/runner-linux:1.4
# RUNNER_IMAGE_LINUX=registry.bank.local/maestro/runner-linux@sha256:REPLACE_WITH_A_REAL_DIGEST

# Wall-clock budget for ONE verification command, seconds. Optional; default
# 1800 (30 min). The runner enforces its own ceiling on top of this, so a value
# above it is refused rather than silently clamped.
# RUNNER_COMMAND_TIMEOUT_SECONDS=1800

# Windows and macOS runners are OUT OF SCOPE for this image — there is no
# RUNNER_IMAGE_WINDOWS/RUNNER_IMAGE_MACOS, and setting one does nothing. A repo
# whose `.maestro.yaml` declares a non-Linux platform refuses at the
# engineering turn instead of running its commands somewhere they do not
# belong. See deploy/SURUM-NOTU.md.


# ─────────────────────────────────────────────────────────────────────────────
# Redis — cross-process coordination (M4)
# ─────────────────────────────────────────────────────────────────────────────
#
# The atomic token bucket (M19), the capacity semaphore, the distributed lock
# and the cache layer. compose.yaml sets REDIS_URL to the in-network service;
# set it here only to point at a Redis this stack does not run.
#
# It is REQUIRED for any deployment with more than one replica. Without it each
# process keeps its own token bucket and its own capacity count, so N replicas
# grant N times the configured LLM rate and N times the sandbox capacity —
# `resolveCacheMode` in @maestro/cache refuses to start a production process
# without it for exactly that reason.
#
# REDIS_URL=redis://redis:6379
#
# Memory ceiling for the coordination store. Every key it holds carries a TTL
# and is derivable, so `volatile-ttl` eviction under pressure is correct; the
# default `noeviction` would make a full Redis refuse writes, turning the rate
# limiter into a source of errors rather than of limits.
# REDIS_MAXMEMORY=256mb


# ─────────────────────────────────────────────────────────────────────────────
# Secret VALUES  (dev profile only — NEVER commit these, NEVER set in prod)
# ─────────────────────────────────────────────────────────────────────────────
#
# In the dev profile the env-file secret driver resolves each *_REF above from
# the matching variable below: `kv/jira#token` → MAESTRO_SECRET_KV_JIRA__TOKEN.
# (Double underscore before the field — see the note below, which is the whole
# reason this line spells it out rather than approximating it.)
# In the prod profile these must not be set at all — the driver refuses to run
# under NODE_ENV=production precisely so that a stale dev value cannot become a
# bank's live credential (M80).

# Note the DOUBLE underscore before the field: the driver encodes `/` as `_`
# and `#` as `__`, so `kv/jira#token` is MAESTRO_SECRET_KV_JIRA__TOKEN.
# It is not MAESTRO_SECRET_KV_JIRA_TOKEN — a name that differs by that one
# underscore looks set to an operator and unset to the driver.
# MAESTRO_SECRET_KV_JIRA__TOKEN=
# MAESTRO_SECRET_KV_JIRA__WEBHOOK=
# MAESTRO_SECRET_KV_ADO__TOKEN=
# MAESTRO_SECRET_KV_ADO__WEBHOOK=
# `api-key` contains a hyphen, which is not legal in a variable name, so the
# driver escapes it as its code point: `__2D_`.
# MAESTRO_SECRET_KV_LLM__API__2D_KEY=
# The LDAP service-account password, for a dev directory only. `service-password`
# contains a hyphen, escaped the same way: `__2D_`.
# MAESTRO_SECRET_KV_LDAP__SERVICE__2D_PASSWORD=
