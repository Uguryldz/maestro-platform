{
  "name": "@maestro/deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Composition root (M44): binds real drivers to real ports, and boots the BFF and the Temporal worker",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start:bff": "tsx src/bin/bff.ts",
    "start:pilot": "tsx src/bin/pilot.ts",
    "start:worker": "tsx src/bin/worker.ts",
    "migrate": "tsx src/bin/migrate.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@maestro/adapter-ado": "workspace:*",
    "@maestro/adapter-github": "workspace:*",
    "@maestro/adapter-jira": "workspace:*",
    "@maestro/adapter-ldap": "workspace:*",
    "@maestro/audit": "workspace:*",
    "@maestro/bff": "workspace:*",
    "@maestro/claude-driver": "workspace:*",
    "@maestro/config": "workspace:*",
    "@maestro/contracts": "workspace:*",
    "@maestro/db": "workspace:*",
    "@maestro/execution": "workspace:*",
    "@maestro/llm-gateway": "workspace:*",
    "@maestro/memory": "workspace:*",
    "@maestro/notify": "workspace:*",
    "@maestro/pii": "workspace:*",
    "@maestro/pilot": "workspace:*",
    "@maestro/ports": "workspace:*",
    "@maestro/publish": "workspace:*",
    "@maestro/runners": "workspace:*",
    "@maestro/scanners": "workspace:*",
    "@maestro/secrets": "workspace:*",
    "@maestro/storage": "workspace:*",
    "@maestro/workflows": "workspace:*",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "fastify": "^5.2.0",
    "tsx": "^4.23.11",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "yaml": "^2.7.0"
  }
}
